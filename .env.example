# ============================================================
#  Valdopalapines.lt — aplinkos kintamieji
#  Nukopijuok šį failą į `.env` ir suvesk realias reikšmes.
# ============================================================

# ---------- Vieša (baked į build; NEXT_PUBLIC_) ----------
NEXT_PUBLIC_SITE_URL=https://valdopalapines.lt
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...     # nebūtina; tuščia -> Turnstile išjungtas
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX                    # GA4 Measurement ID (nebūtina)
NEXT_PUBLIC_META_PIXEL_ID=000000000000000        # Meta Pixel ID (nebūtina)
NEXT_PUBLIC_LEAD_VALUE=40                         # proxy „lead" vertė € (nebūtina)

# ---------- Serverio paslaptys (runtime; NIEKADA į git) ----------
SANITY_API_READ_TOKEN=sk...                       # nebūtina viešam datasetui
SANITY_REVALIDATE_SECRET=ilgas-atsitiktinis-tekstas
RESEND_API_KEY=re_xxxxxxxx
QUOTE_TO_EMAIL=kaimynas@pastas.lt
QUOTE_FROM_EMAIL=uzklausos@valdopalapines.lt      # verifikuotas Resend domenas
TURNSTILE_SECRET_KEY=0x4AAAAAAA...                # poroje su NEXT_PUBLIC_TURNSTILE_SITE_KEY
META_CAPI_TOKEN=EAAxxxxxxxx                        # Meta Conversions API (nebūtina)

# ---------- TIK lokaliam seed'inimui (ne serveryje) ----------
SANITY_API_WRITE_TOKEN=sk...                       # Editor teisės; reikia `npm run seed`
