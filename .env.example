# ============================================================
#  Valdopalapines.lt — aplinkos kintamieji
#  Nukopijuok šį failą į `.env` ir suvesk realias reikšmes.
#  Eilutės, prasidedančios `#`, yra IŠJUNGTOS (nebūtinos). Norėdamas
#  įjungti — ištrink `#` priekyje ir įrašyk tikrą reikšmę.
#  Pilnas aprašas: README-MASTER-GIDAS.md, "A priedas".
# ============================================================

# ---------- Privalomi (vieši; įkepami į build) ----------
NEXT_PUBLIC_SITE_URL=https://valdopalapines.lt
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production

# ---------- Privalomi (serverio paslaptys; NIEKADA į git) ----------
SANITY_REVALIDATE_SECRET=ilgas-atsitiktinis-tekstas
RESEND_API_KEY=re_xxxxxxxx
QUOTE_TO_EMAIL=kaimynas@pastas.lt
QUOTE_FROM_EMAIL=uzklausos@valdopalapines.lt      # domenas po @ turi būti patvirtintas Resend

# ---------- Nebūtini (išjungti, kol neįjungsi) ----------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...     # Cloudflare Turnstile; poroje su TURNSTILE_SECRET_KEY
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX                   # GA4 Measurement ID
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000        # Meta Pixel ID
# NEXT_PUBLIC_LEAD_VALUE=40                        # proxy „lead" vertė € (reklamoms)
# META_CAPI_TOKEN=EAAxxxxxxxx                      # Meta Conversions API
# SANITY_API_READ_TOKEN=sk...                      # reikia tik jei dataset NE viešas

# ---------- TIK Tavo kompiuteryje (ne serveryje) ----------
# SANITY_API_WRITE_TOKEN=sk...                     # Editor teisės; reikia tik `npm run seed`
SANITY_STUDIO_PROJECT_ID=xxxxxxxx                  # TAS PATS ID kaip NEXT_PUBLIC_SANITY_PROJECT_ID (`sanity dev` / `sanity deploy`)
SANITY_STUDIO_DATASET=production
